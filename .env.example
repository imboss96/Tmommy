# Local environment configuration. Replace every placeholder before use.

# Supabase browser configuration. Safe for the frontend when using the anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_URL="http://localhost:5000"
# For production, set this to the public HTTPS origin, for example:
# VITE_API_URL="https://your-domain.com"

# Backend-only Supabase credentials. Never use the service role key in VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Cloudinary server configuration. Never expose these with a VITE_ prefix.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Transactional email notifications (Brevo). Use a sender verified in Brevo.
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=app@tmommycares.com
BREVO_SENDER_NAME=MommyCare
NOTIFICATION_EMAIL=info@tmommycares.com

# Application URL used by the backend and deployment platform.
APP_URL="http://localhost:3000"
# For production, set this to your live HTTPS origin, for example:
# APP_URL="https://your-domain.com"
# Public HTTPS URL that Safaricom can reach for payment callbacks, for example:
# MPESA_CALLBACK_URL="https://your-domain.com/api/payments/mpesa/callback"
# Generate a 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this backend-only key stable; rotating it makes saved M-Pesa credentials unreadable.
MPESA_CONFIG_ENCRYPTION_KEY=YOUR_64_CHARACTER_HEX_ENCRYPTION_KEY
# Add extra origins if needed, comma-separated. Example:
# CORS_ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com,http://localhost:3000"
PORT=5000
