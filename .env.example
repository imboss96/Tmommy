# Public Supabase browser configuration. These values are safe to expose in the frontend.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_API_URL="http://localhost:5000"

# Backend-only Supabase credentials. Never expose the service role key to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Cloudinary test configuration.
# Key name: CHRIS
CLOUDINARY_CLOUD_NAME="doeiwicww"
CLOUDINARY_API_KEY="873321121417721"
# Required only for signed server-side uploads; never expose this in VITE_* variables.
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PORT=5000
ADMIN_PIN="change-this-admin-pin"
